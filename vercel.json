{
  "rewrites": [
    { "source": "/gifting", "destination": "/gifting.html" },
    { "source": "/gifting/(.*)", "destination": "/gifting.html" },
    { "source": "/gift-cards", "destination": "/gifting.html" },
    { "source": "/prices", "destination": "/prices.html" },
    { "source": "/gift/(.*)", "destination": "/api/gift/$1" },
    { "source": "/catalogue/(.*)", "destination": "/api/catalogue/$1" },
    {
      "source": "/shop/:group",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(WhatsApp|facebookexternalhit|Facebot|meta-externalagent|Twitterbot|TelegramBot|LinkedInBot|Slackbot|Discordbot|Pinterestbot|SkypeUriPreview).*" }],
      "destination": "/api/shop?group=:group"
    },
    {
      "source": "/shop/:group/:category",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(WhatsApp|facebookexternalhit|Facebot|meta-externalagent|Twitterbot|TelegramBot|LinkedInBot|Slackbot|Discordbot|Pinterestbot|SkypeUriPreview).*" }],
      "destination": "/api/shop?group=:group&category=:category"
    },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
